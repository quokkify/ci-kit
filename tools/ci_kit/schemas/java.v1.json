{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ci-kit java module declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "path",
          "java_version"
        ],
        "properties": {
          "build_command": {
            "type": "string"
          },
          "build_tool": {
            "type": "string"
          },
          "cache_dependencies": {
            "type": "boolean"
          },
          "cache_jdk": {
            "type": "boolean"
          },
          "distribution": {
            "type": "string"
          },
          "gradle_console": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "install_command": {
            "type": "string"
          },
          "java_version": {
            "enum": [
              "17",
              "21",
              "25"
            ]
          },
          "lint_command": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!(.*/)?\\.\\.(/|$))[^*?\\[]*$"
          },
          "run_build": {
            "type": "boolean"
          },
          "run_lint": {
            "type": "boolean"
          },
          "run_tests": {
            "type": "boolean"
          },
          "test_artifact_name": {
            "type": "string"
          },
          "test_artifact_path": {
            "type": "string"
          },
          "test_command": {
            "type": "string"
          },
          "test_modules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "module"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
                },
                "module": {
                  "type": "string",
                  "pattern": "^\\S+$"
                },
                "test_command": {
                  "type": "string",
                  "minLength": 1
                },
                "results": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!(.*/)?\\.\\.(/|$))[^*?\\[]*$"
                }
              }
            }
          },
          "timeout_minutes": {
            "type": "integer",
            "minimum": 1
          },
          "upload_test_artifacts": {
            "type": "boolean"
          }
        },
        "dependentSchemas": {
          "test_modules": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "test_command"
                  ]
                },
                {
                  "required": [
                    "upload_test_artifacts"
                  ]
                },
                {
                  "required": [
                    "test_artifact_name"
                  ]
                },
                {
                  "required": [
                    "test_artifact_path"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  }
}
