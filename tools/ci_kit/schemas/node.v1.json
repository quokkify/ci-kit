{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ci-kit node module declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "build_command": {
            "type": "string"
          },
          "cache_dependencies": {
            "type": "boolean"
          },
          "corepack_version": {
            "type": "string"
          },
          "install_command": {
            "type": "string"
          },
          "lint_command": {
            "type": "string"
          },
          "node_version": {
            "type": "string"
          },
          "package_manager": {
            "type": "string"
          },
          "run_build": {
            "type": "boolean"
          },
          "run_lint": {
            "type": "boolean"
          },
          "run_tests": {
            "type": "boolean"
          },
          "test_artifact_name": {
            "type": "string"
          },
          "test_artifact_path": {
            "type": "string"
          },
          "test_command": {
            "type": "string"
          },
          "timeout_minutes": {
            "type": "integer",
            "minimum": 1
          },
          "upload_test_artifacts": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
