{%- set codeql_state = namespace(languages=['actions']) -%}
{%- if codeql_languages -%}
{%- set codeql_state.languages = codeql_languages -%}
{%- else -%}
{%- for component in components -%}
{%- set language = {'python': 'python', 'node': 'javascript-typescript', 'java': 'java-kotlin'}[component.type] -%}
{%- if language not in codeql_state.languages -%}{%- set codeql_state.languages = codeql_state.languages + [language] -%}{%- endif -%}
{%- endfor -%}
{%- endif -%}
name: CodeQL

on:
  pull_request:
  push:
    branches: [main]
  schedule:
    - cron: "0 3 * * 6"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: codeql-{% raw %}${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  analyze:
    name: Analyze ({% raw %}${{ matrix.language }}{% endraw %})
    runs-on: ubuntu-latest
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        language: {{ codeql_state.languages | to_json }}
    permissions:
      actions: read
      contents: read
      security-events: write
    steps:
      - name: Check out repository
        uses: quokkify/ci-kit/actions/checkout@{{ toolkit_version }}
        with:
          fetch-depth: 2
          persist-credentials: false
      - name: Initialize CodeQL
        uses: github/codeql-action/init@2892aa5e19bbd11bc0cff5427e3b750a04d9e3c2 # v4
        with:
          languages: {% raw %}${{ matrix.language }}{% endraw %}
          build-mode: none
      - name: Perform CodeQL analysis
        uses: github/codeql-action/analyze@2892aa5e19bbd11bc0cff5427e3b750a04d9e3c2 # v4
        with:
          category: "/language:{% raw %}${{ matrix.language }}{% endraw %}"
