name: Allure report

on:
  workflow_run:
    workflows: [Validate{% if allure_external_workflow_name != 'Validate' %}, {{ allure_external_workflow_name | tojson }}{% endif %}]
    types: [completed]

permissions: {}

concurrency:
  group: allure-report-{% raw %}${{ github.event.workflow_run.workflow_id }}-${{ github.event.workflow_run.head_repository.id }}-${{ github.event.workflow_run.head_branch }}{% endraw %}
  cancel-in-progress: true

jobs:
  report:
    name: Generate and comment trusted Allure report
    uses: quokkify/ci-kit/.github/workflows/allure-publisher-core.yml@{{ toolkit_version }}
    permissions:
      actions: read
      contents: read
      pull-requests: write
    with:
      source-workflow: {% if allure_mode == 'component' %}Validate{% else %}{{ allure_external_workflow_name | tojson }}{% endif %}
      source-workflow-path: {% if allure_mode == 'component' %}.github/workflows/validate.yml{% else %}{{ allure_external_workflow_path | tojson }}{% endif %}
      artifact-prefix: {% if allure_mode == 'component' %}allure-results-{% else %}{{ allure_external_artifact_prefix | tojson }}{% endif %}
      artifact-mode: {% if allure_mode == 'component' %}component{% else %}external{% endif %}
      minimum-artifacts: {% if allure_mode == 'component' %}1{% else %}{{ allure_external_artifact_min_count }}{% endif %}
      maximum-artifacts: {% if allure_mode == 'component' %}50{% else %}{{ allure_external_artifact_max_count }}{% endif %}
      skip-empty-artifacts: {% if allure_mode == 'component' %}false{% else %}true{% endif %}
      config-file: .github/allure/allurerc.mjs
      categories-file: {{ allure_categories_file | tojson }}
      publish-pages: {{ 'true' if allure_publish_pages else 'false' }}
      managed-pages-layout: true
      history-path: allure-history/history.jsonl
      pages-url: {% if allure_publish_pages %}{{ allure_pages_url | tojson }}{% else %}""{% endif %}
{% if allure_publish_pages %}
  pages:
    name: Publish trusted Pages report
    needs: report
    if: {% raw %}${{ needs.report.outputs.ready == 'true' && needs.report.outputs.fork-pr == 'false' }}{% endraw %}
    uses: quokkify/ci-kit/.github/workflows/allure-pages.yml@{{ toolkit_version }}
    permissions:
      actions: read
      contents: write
      pull-requests: read
    with:
      source-workflow: {% if allure_mode == 'component' %}Validate{% else %}{{ allure_external_workflow_name | tojson }}{% endif %}
      source-workflow-path: {% if allure_mode == 'component' %}.github/workflows/validate.yml{% else %}{{ allure_external_workflow_path | tojson }}{% endif %}
      managed-pages-layout: true
      pr-number: {% raw %}${{ needs.report.outputs.pr-number }}{% endraw %}
      pages-destination-directory: {% raw %}${{ format('allure/pr-{0}', needs.report.outputs.pr-number) }}{% endraw %}
{% endif %}
