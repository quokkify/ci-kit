name: CodeQL

on:
  pull_request:
  push:
    branches: [main]
  schedule:
    - cron: "0 3 * * 6"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: codeql-{% raw %}${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  codeql:
    permissions:
      actions: read
      contents: read
      security-events: write
    uses: quokkify/ci-kit/.github/workflows/codeql-analysis.yml@{{ toolkit_version }}
    with:
      languages-override: {{ codeql_languages | to_json | tojson }}
