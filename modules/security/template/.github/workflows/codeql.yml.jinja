name: CodeQL

on:
  pull_request:
  push:
    branches: [main]
  schedule:
    - cron: "0 3 * * 6"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: codeql-{% raw %}${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  codeql:
    permissions:
      actions: read
      contents: read
      security-events: write
    uses: quokkify/ci-kit/.github/workflows/codeql-analysis.yml@{{ toolkit_version }}
    with:
      languages-override: {{ ("'" ~ (codeql_languages | to_json) ~ "'") if codeql_languages else '"[]"' }}
{%- if codeql_aggregate | default(false) %}

  complete:
    name: CodeQL
    if: always()
    needs: codeql
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Require every CodeQL analysis to pass
        env:
          ANALYZE_RESULT: {% raw %}${{ needs.codeql.result }}{% endraw %}
        run: test "$ANALYZE_RESULT" = success
{%- endif %}
