name: PR contract

# PR titles and the `## Release note` / `## Migration` sections become the
# release notes. See "Pull request titles and release notes" in docs/ci-kit.md.
on:
  pull_request:
    types:
      - opened
      - edited
      - synchronize
      - reopened
      - ready_for_review
      - labeled
      - unlabeled

permissions: {}

concurrency:
  group: pr-contract-{% raw %}${{ github.event.pull_request.number }}{% endraw %}
  cancel-in-progress: true

jobs:
  contract:
    name: PR contract
    uses: quokkify/ci-kit/.github/workflows/pr-contract.yml@{{ toolkit_version }}
    with:
      enforce: false
