name: Labels

on:
  push:
    branches: [main]
    paths:
      - .github/labels.yml
      - .github/workflows/labels.yml
  schedule:
    - cron: "17 4 * * 1"
  workflow_dispatch:
    inputs:
      dry-run:
        description: Only report the label changes.
        type: boolean
        default: false

permissions:
  contents: read
  issues: write

concurrency:
  group: labels-sync
  cancel-in-progress: false

jobs:
  sync:
    uses: quokkify/ci-kit/.github/workflows/labels-sync.yml@{{ toolkit_version }}
    with:
      dry-run: {% raw %}${{ inputs.dry-run == true }}{% endraw %}
