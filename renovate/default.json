{
  "description": [
    "Shared dependency policy for repositories consuming ci-kit.",
    "Updates GitHub Actions and versioned reusable workflow references without automerge."
  ],
  "extends": ["config:recommended"],
  "enabledManagers": ["github-actions", "custom.regex"],
  "semanticCommits": "enabled",
  "semanticCommitType": "deps",
  "semanticCommitScope": "{{manager}}",
  "automerge": false,
  "packageRules": [
    {
      "description": "Group non-breaking GitHub Actions updates.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "github actions non-major updates"
    },
    {
      "description": "Group non-breaking ci-kit workflow updates.",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["quokkify/ci-kit"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "ci-kit non-major updates"
    },
    {
      "description": "Deduplicate Allure action updates across built-in and custom managers.",
      "matchManagers": ["github-actions", "custom.regex"],
      "matchPackageNames": ["quokkify/allure-report-action"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "quokkify/allure-report-action non-major updates"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update exact SemVer references to reusable ci-kit workflows.",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "uses:\\s*quokkify/ci-kit/\\.github/workflows/[^@\\s]+@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "quokkify/ci-kit",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ]
}
