name: Allure report

on:
  workflow_run:
    workflows: [Validate{% if allure_external_workflow_name != 'Validate' %}, {{ allure_external_workflow_name | tojson }}{% endif %}]
    types: [completed]

permissions: {}

concurrency:
  group: allure-report-{% raw %}${{ github.event.workflow_run.head_repository.id }}-${{ github.event.workflow_run.head_branch }}{% endraw %}
  cancel-in-progress: true

jobs:
  resolve:
    name: Resolve trusted source run
    if: >-
      {% raw %}${{
        github.event.workflow_run.event == 'pull_request' &&
        contains(
          fromJSON('["success","failure","neutral","timed_out"]'),
          github.event.workflow_run.conclusion
        )
      }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      actions: read
      contents: read
      pull-requests: read
    outputs:
      ready: {% raw %}${{ steps.resolve.outputs.ready }}{% endraw %}
      pr-number: {% raw %}${{ steps.resolve.outputs.pr-number }}{% endraw %}
      fork-pr: {% raw %}${{ steps.resolve.outputs.fork-pr }}{% endraw %}
      artifact_manifest: {% raw %}${{ steps.resolve.outputs.artifact_manifest }}{% endraw %}
      materialize-root: {% raw %}${{ steps.resolve.outputs.materialize-root }}{% endraw %}
      source-artifacts-directory: {% raw %}${{ steps.resolve.outputs.source-artifacts-directory }}{% endraw %}
    steps:
      - name: Resolve PR and validate source artifacts
        id: resolve
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        with:
          script: |
            const run = context.payload.workflow_run;
            const artifactPrefix = {{ allure_external_artifact_prefix | tojson }};
            const minimumArtifacts = {{ allure_external_artifact_min_count }};
            const maximumArtifacts = {{ allure_external_artifact_max_count }};
            const componentWorkflowPath = ".github/workflows/validate.yml";
            const externalWorkflowPath = {{ allure_external_workflow_path | tojson }};
            const componentMode = {{ "true" if components else "false" }};
            const externalMode = {{ "false" if components else "true" }};
            const materializeRoot = componentMode ? ".allure-input/results" : ".allure-input/source-artifacts";
            const sourceArtifactsDirectory = componentMode ? "" : ".allure-input/source-artifacts";
            const skip = (message) => {
              core.warning(message);
              core.setOutput("ready", "false");
            };
            const componentRun = componentMode && run.path === componentWorkflowPath;
            const externalRun = externalMode && run.path === externalWorkflowPath;
            if (!componentRun && !externalRun) {
              skip(`Ignore unexpected source workflow path: ${run.path}`);
              return;
            }
            const headRepository = run.head_repository?.full_name;
            if (!headRepository || !run.head_sha) {
              skip("Source run has no live head repository or SHA.");
              return;
            }
            const pulls = await github.paginate(github.rest.pulls.list, {
              owner: context.repo.owner,
              repo: context.repo.repo,
              state: "open",
              per_page: 100,
            });
            const matches = pulls.filter((pull) =>
              pull.base?.repo?.full_name === `${context.repo.owner}/${context.repo.repo}` &&
              pull.head?.repo?.full_name === headRepository &&
              pull.head?.sha === run.head_sha
            );
            if (matches.length !== 1) {
              skip(`Expected exactly one current open PR for source SHA; found ${matches.length}.`);
              return;
            }
            const sourceRuns = await github.paginate(github.rest.actions.listWorkflowRuns, {
              owner: context.repo.owner,
              repo: context.repo.repo,
              workflow_id: run.workflow_id,
              event: "pull_request",
              head_sha: run.head_sha,
              per_page: 100,
            });
            const newestRunId = Math.max(...sourceRuns.map((candidate) => Number(candidate.id)));
            if (!Number.isSafeInteger(newestRunId) || Number(run.id) !== newestRunId) {
              skip("A newer source workflow run exists for this PR head; stale report suppressed.");
              return;
            }
            const artifacts = await github.paginate(github.rest.actions.listWorkflowRunArtifacts, {
              owner: context.repo.owner,
              repo: context.repo.repo,
              run_id: run.id,
              per_page: 100,
            });
            const allureArtifacts = artifacts.filter((artifact) =>
              artifact.name.startsWith(componentRun ? "allure-results-" : artifactPrefix)
            );
            const actualNames = allureArtifacts.map((artifact) => artifact.name).sort();
            // The source run is authoritative for component artifact identities.  The
            // trusted report workflow may be updated before a consumer's source run,
            // so matching against this workflow's current component IDs would drop
            // reports during a migration.  Keep the contract versioned and strict
            // without coupling it to the report workflow's component inventory.
            const sourceArtifactContractVersion = 1;
            const componentArtifactPattern = /^allure-results-[A-Za-z_][A-Za-z0-9_-]*$/;
            if (componentRun && (sourceArtifactContractVersion !== 1 || actualNames.length === 0 ||
                actualNames.some((name) => !componentArtifactPattern.test(name)) ||
                new Set(actualNames).size !== actualNames.length)) {
              core.setFailed(`Allure artifact contract v${sourceArtifactContractVersion} mismatch; received ${actualNames.join(", ") || "none"}.`);
              return;
            }
            if (externalRun && actualNames.length === 0) {
              skip("No external Allure artifacts found; report generation skipped.");
              return;
            }
            if (externalRun && (actualNames.length < minimumArtifacts || actualNames.length > maximumArtifacts ||
                new Set(actualNames).size !== actualNames.length)) {
              core.setFailed(`External Allure artifact contract mismatch. Expected ${minimumArtifacts}-${maximumArtifacts} unique artifacts with prefix ${artifactPrefix}; received ${actualNames.length}.`);
              return;
            }
            if (allureArtifacts.some((artifact) => artifact.expired)) {
              core.setFailed("One or more required Allure artifacts have expired.");
              return;
            }
            const compressedBytes = allureArtifacts.reduce(
              (total, artifact) => total + Number(artifact.size_in_bytes || 0),
              0,
            );
            if (compressedBytes > 262144000) {
              core.setFailed(`Allure artifacts exceed the 250 MiB compressed limit: ${compressedBytes} bytes.`);
              return;
            }
            core.setOutput("artifact_manifest", JSON.stringify(
              allureArtifacts.map((artifact) => ({
                name: artifact.name,
                id: Number(artifact.id),
              }))
            ));
            core.setOutput("materialize-root", materializeRoot);
            core.setOutput("source-artifacts-directory", sourceArtifactsDirectory);
            const pull = matches[0];
            core.setOutput("ready", "true");
            core.setOutput("pr-number", String(pull.number));
            const pagesUnsafe = pull.head.repo.full_name !== pull.base.repo.full_name ||
              pull.user?.login === "dependabot[bot]";
            core.setOutput("fork-pr", String(pagesUnsafe));

  generate:
    name: Generate unprivileged report
    needs: resolve
    if: {% raw %}${{ needs.resolve.outputs.ready == 'true' }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      actions: read
      contents: read
    steps:
      - name: Check out trusted report configuration
        uses: quokkify/project-toolkit/actions/checkout@{{ toolkit_version }}
        with:
          ref: {% raw %}${{ github.sha }}{% endraw %}
          persist-credentials: false
      - name: Download, preflight, and merge Allure results
        shell: bash
        env:
          ARTIFACT_MANIFEST: {% raw %}${{ needs.resolve.outputs.artifact_manifest }}{% endraw %}
          API_URL: {% raw %}${{ github.api_url }}{% endraw %}
          REPOSITORY: {% raw %}${{ github.repository }}{% endraw %}
          GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          ARCHIVE_ROOT: {% raw %}${{ runner.temp }}{% endraw %}/allure-archives
          OUTPUT_ROOT: {% raw %}${{ runner.temp }}{% endraw %}/allure-expanded
          MATERIALIZE_ROOT: {% raw %}${{ github.workspace }}{% endraw %}/{% raw %}${{ needs.resolve.outputs.materialize-root }}{% endraw %}
        run: python .github/allure/safe_extract.py
      - name: Build Allure report without write privileges
        uses: quokkify/project-toolkit/actions/allure-report@{{ toolkit_version }}
        with:
          github-token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          results-directory: .allure-input/results
          source-artifacts-directory: {% raw %}${{ needs.resolve.outputs.source-artifacts-directory }}{% endraw %}
          report-directory: allure-report
          config-file: .github/allure/allurerc.mjs
{% if allure_categories_file %}          categories-file: {{ allure_categories_file | tojson }}
{% endif %}          source-run-id: {% raw %}${{ github.event.workflow_run.id }}{% endraw %}
          pages-url: {% if allure_publish_pages %}"{{ allure_pages_url }}/allure/pr-{% raw %}${{ needs.resolve.outputs.pr-number }}{% endraw %}/allure-report/"{% else %}""{% endif %}
          fork-pr: {% raw %}${{ needs.resolve.outputs.fork-pr }}{% endraw %}
          comment-marker: "<!-- project-toolkit-allure-report -->"
      - name: Upload generated Allure HTML
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: allure-report-{% raw %}${{ github.run_id }}{% endraw %}
          path: |
            allure-report
            allure-pr-comment.md
          if-no-files-found: error
          retention-days: 14

  comment:
    name: Publish trusted PR comment
    needs: [resolve, generate]
    if: {% raw %}${{ needs.resolve.outputs.ready == 'true' }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      actions: read
      pull-requests: write
    steps:
      - name: Download generated report and compact comment
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: allure-report-{% raw %}${{ github.run_id }}{% endraw %}
          path: .allure-generated
          github-token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          run-id: {% raw %}${{ github.run_id }}{% endraw %}
      - name: Revalidate source freshness and update comment
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        env:
          PR_NUMBER: {% raw %}${{ needs.resolve.outputs.pr-number }}{% endraw %}
        with:
          script: |
            const run = context.payload.workflow_run;
            const prNumber = Number(process.env.PR_NUMBER);
            const { data: pull } = await github.rest.pulls.get({
              owner: context.repo.owner,
              repo: context.repo.repo,
              pull_number: prNumber,
            });
            if (pull.state !== "open" || pull.head?.sha !== run.head_sha ||
                pull.head?.repo?.full_name !== run.head_repository?.full_name) {
              core.warning("PR head changed; stale Allure comment suppressed.");
              return;
            }
            const sourceRuns = await github.paginate(github.rest.actions.listWorkflowRuns, {
              owner: context.repo.owner,
              repo: context.repo.repo,
              workflow_id: run.workflow_id,
              event: "pull_request",
              head_sha: run.head_sha,
              per_page: 100,
            });
            if (Number(run.id) !== Math.max(...sourceRuns.map((candidate) => Number(candidate.id)))) {
              core.warning("A newer source workflow run exists; stale Allure comment suppressed.");
              return;
            }
            const marker = "<!-- project-toolkit-allure-report -->";
            const body = require("fs").readFileSync(".allure-generated/allure-pr-comment.md", "utf8").trimEnd();
            if ((body.match(new RegExp(marker, "g")) || []).length !== 1 || !body.endsWith(marker)) {
              core.setFailed("Generated Allure comment must contain exactly one marker as its final line.");
              return;
            }
            const comments = await github.paginate(github.rest.issues.listComments, {
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: prNumber,
              per_page: 100,
            });
            const existing = comments.find((comment) =>
              comment.user?.login === "github-actions[bot]" && (comment.body || "").includes(marker)
            );
            if (existing) {
              await github.rest.issues.updateComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                comment_id: existing.id,
                body,
              });
            } else {
              await github.rest.issues.createComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: prNumber,
                body,
              });
            }
{% if allure_publish_pages %}
  pages:
    name: Publish trusted Pages report
    needs: [resolve, generate]
    if: >-
      {% raw %}${{
        needs.resolve.outputs.ready == 'true' &&
        needs.resolve.outputs.fork-pr == 'false'
      }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      actions: read
      contents: write
      pull-requests: read
    steps:
      - name: Revalidate source freshness
        id: freshness
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        env:
          PR_NUMBER: {% raw %}${{ needs.resolve.outputs.pr-number }}{% endraw %}
        with:
          script: |
            const run = context.payload.workflow_run;
            const prNumber = Number(process.env.PR_NUMBER);
            const { data: pull } = await github.rest.pulls.get({
              owner: context.repo.owner,
              repo: context.repo.repo,
              pull_number: prNumber,
            });
            const sameHead = pull.state === "open" && pull.head?.sha === run.head_sha &&
              pull.head?.repo?.full_name === run.head_repository?.full_name;
            const sourceRuns = await github.paginate(github.rest.actions.listWorkflowRuns, {
              owner: context.repo.owner,
              repo: context.repo.repo,
              workflow_id: run.workflow_id,
              event: "pull_request",
              head_sha: run.head_sha,
              per_page: 100,
            });
            const latest = Number(run.id) === Math.max(
              ...sourceRuns.map((candidate) => Number(candidate.id))
            );
            if (!sameHead || !latest) {
              core.warning("PR head or source run is stale; Pages publication suppressed.");
              core.setOutput("fresh", "false");
              return;
            }
            const expectedName = `allure-report-${context.runId}`;
            const reportArtifacts = await github.paginate(
              github.rest.actions.listWorkflowRunArtifacts,
              {
                owner: context.repo.owner,
                repo: context.repo.repo,
                run_id: context.runId,
                per_page: 100,
              }
            );
            const matches = reportArtifacts.filter((artifact) => artifact.name === expectedName);
            if (matches.length !== 1 || matches[0].expired ||
                Number(matches[0].size_in_bytes || 0) > 262144000) {
              core.setFailed("Generated report artifact failed identity, expiry, or compressed-size checks.");
              return;
            }
            core.setOutput("artifact_manifest", JSON.stringify([
              { name: expectedName, id: Number(matches[0].id) },
            ]));
            core.setOutput("fresh", "true");
      - name: Check out trusted extractor
        if: {% raw %}${{ steps.freshness.outputs.fresh == 'true' }}{% endraw %}
        uses: quokkify/project-toolkit/actions/checkout@{{ toolkit_version }}
        with:
          ref: {% raw %}${{ github.sha }}{% endraw %}
          persist-credentials: false
      - name: Safely download generated report
        if: {% raw %}${{ steps.freshness.outputs.fresh == 'true' }}{% endraw %}
        shell: bash
        env:
          ARTIFACT_MANIFEST: {% raw %}${{ steps.freshness.outputs.artifact_manifest }}{% endraw %}
          API_URL: {% raw %}${{ github.api_url }}{% endraw %}
          REPOSITORY: {% raw %}${{ github.repository }}{% endraw %}
          GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          ARCHIVE_ROOT: {% raw %}${{ runner.temp }}{% endraw %}/allure-pages-archives
          OUTPUT_ROOT: {% raw %}${{ runner.temp }}{% endraw %}/allure-pages-expanded
          MATERIALIZE_ROOT: {% raw %}${{ github.workspace }}{% endraw %}/allure-report
        run: python .github/allure/safe_extract.py
      - name: Publish Allure HTML to GitHub Pages
        if: {% raw %}${{ steps.freshness.outputs.fresh == 'true' }}{% endraw %}
        uses: quokkify/project-toolkit/actions/deploy-gh-pages-subdir@{{ toolkit_version }}
        with:
          token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          publish-dir: allure-report
          destination-dir: allure/pr-{% raw %}${{ needs.resolve.outputs.pr-number }}{% endraw %}
{% endif %}
